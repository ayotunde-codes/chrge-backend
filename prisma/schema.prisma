// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // In production (Neon): DATABASE_URL = pooled URL, DIRECT_URL = direct URL.
  // In local dev: both vars point to the same Docker Postgres instance.
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum UserRole {
  USER
  ADMIN
  OPERATOR
}

enum AccountType {
  CONSUMER
  STAFF
  SERVICE
}

enum StaffStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ConnectorType {
  CCS1
  CCS2
  CHADEMO
  TESLA
  J1772
  TYPE_2 // Type 2 (Mennekes) AC - matches frontend
  TYPE2 // Legacy (ports may use this)
  NACS
  GB_T // Chinese standard
}

enum PortStatus {
  AVAILABLE
  IN_USE
  OUT_OF_ORDER
  UNKNOWN
}

enum ChargerType {
  LEVEL1
  LEVEL2
  DCFC
}

enum PowertrainType {
  BEV // Battery electric
  PHEV // Plug-in hybrid
  EREV // Extended-range electric
}

enum StationStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AuditSensitivity {
  STANDARD
  SENSITIVE
  RESTRICTED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  QUARANTINED
  FAILED
}

enum StationType {
  EV
  CNG
  HYBRID
}

enum CngApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  INSPECTION_APPOINTMENT_BOOKED
  FINANCING_APPROVED
  CONVERSION_APPOINTMENT_BOOKED
  FINANCE_DISBURSED
  CONVERSION_COMPLETED
  REPAYMENT_ACTIVE
  FULLY_PAID
  REJECTED
  CANCELLED
}

enum CngInstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum CngAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
  TEMPORARILY_DISABLED
}

enum StationAssociationRole {
  EMPLOYEE
  MANAGER
}

enum StationAssociationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum StationConditionSource {
  STATION_PORTAL
  ADMIN
}

enum CngNotificationKind {
  FAVORITE_STATION_AVAILABLE
  NETWORK_DIGEST
}

enum CngNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String? // Null for OAuth-only users
  firstName     String?
  lastName      String?
  avatarUrl     String?
  provider      AuthProvider @default(EMAIL)
  providerId    String? // Google sub, Apple sub, etc.
  emailVerified Boolean      @default(false)
  role          UserRole     @default(USER)
  accountType   AccountType  @default(CONSUMER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  refreshTokens           RefreshToken[]
  userVehicles            UserVehicle[]
  favorites               Favorite[]
  reviews                 Review[]
  submittedStations       Station[]            @relation("SubmittedStations")
  cngApplications         CngApplication[]     @relation("CngApplicant")
  reviewedCngApplications CngApplication[]     @relation("CngReviewer")
  reviewedStations        Station[]            @relation("ReviewedStations")
  auditEvents             AuditEvent[]         @relation("AuditActor")
  staffProfile            StaffProfile?
  staffInvitationsCreated StaffInvitation[]    @relation("StaffInviter")
  staffAuthChallenges     StaffAuthChallenge[]
  passwordResetChallenges PasswordResetChallenge[]
  stationAssociations         StationAssociation[]  @relation("StationAssociationUser")
  approvedStationAssociations StationAssociation[]  @relation("StationAssociationApprover")
  stationConditionReports     StationConditionReport[] @relation("StationConditionReporter")
  stationAvailabilityEvents   StationAvailabilityEvent[] @relation("StationAvailabilityReporter")

  @@index([email])
  @@index([providerId])
  @@map("users")
}

model PasswordResetChallenge {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_challenges")
}

model RefreshToken {
  id            String    @id @default(uuid())
  tokenHash     String    @unique // SHA256 hash of the token
  userId        String
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  audience      String    @default("chrge-consumer")
  environment   String    @default("development")
  mfaVerifiedAt DateTime?
  parentTokenId String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([userId, audience, revokedAt])
  @@map("refresh_tokens")
}

model StaffProfile {
  id                  String      @id @default(uuid())
  userId              String      @unique
  status              StaffStatus @default(INVITED)
  staffRoleId         String
  mfaSecretEncrypted  String?
  mfaEnabledAt        DateTime?
  recoveryCodesHash   Json?
  notificationsReadAt DateTime?
  invitedAt           DateTime?
  activatedAt         DateTime?
  suspendedAt         DateTime?
  disabledAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role StaffRole @relation(fields: [staffRoleId], references: [id])

  @@index([status])
  @@index([staffRoleId, status])
  @@map("staff_profiles")
}

model StaffRole {
  id          String   @id
  name        String   @unique
  description String?
  isTopLevel  Boolean  @default(false)
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       StaffProfile[]
  permissions StaffRolePermission[]
  invitations StaffInvitation[]

  @@map("staff_roles")
}

model StaffPermission {
  id          String                @id
  description String?
  roles       StaffRolePermission[]

  @@map("staff_permissions")
}

model StaffRolePermission {
  roleId       String
  permissionId String
  role         StaffRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   StaffPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("staff_role_permissions")
}

model StaffInvitation {
  id          String    @id @default(uuid())
  email       String
  staffRoleId String
  tokenHash   String    @unique
  invitedBy   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  inviter   User      @relation("StaffInviter", fields: [invitedBy], references: [id])
  staffRole StaffRole @relation(fields: [staffRoleId], references: [id])

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("staff_invitations")
}

model ServicePrincipal {
  id             String    @id @default(uuid())
  name           String    @unique
  credentialHash String    @unique
  scopes         Json
  environment    String
  expiresAt      DateTime
  rotatedAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([environment, revokedAt])
  @@map("service_principals")
}

model StaffAuthChallenge {
  id          String    @id @default(uuid())
  userId      String
  bindingHash String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("staff_auth_challenges")
}

// ============================================================================
// VEHICLES (Brand -> Model -> User Selection)
// ============================================================================

model VehicleBrand {
  id       String   @id // Stable id for frontend (e.g. "tesla", "audi") — images resolved in frontend
  name     String
  logoUrl  String? // Optional; frontend can resolve by id
  darkLogo Boolean? @default(false) // Prefer dark logo variant
  country  String? // Country of origin
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  models VehicleModel[]

  @@index([name])
  @@map("vehicle_brands")
}

model VehicleModel {
  id                 String         @id // Stable id for frontend (e.g. "model-s", "q4-etron")
  brandId            String
  name               String
  powertrain         PowertrainType // BEV, PHEV, EREV
  connectors         Json // Array of ConnectorType strings, e.g. ["NACS", "CCS2"]
  connectorType      ConnectorType? // Optional legacy single connector (first of connectors)
  year               Int? // Model year if specific
  batteryCapacityKwh Float?
  rangeKm            Float? // Estimated range
  imageUrl           String? // Optional; frontend can resolve by id
  isActive           Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  brand        VehicleBrand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userVehicles UserVehicle[]

  @@unique([brandId, name])
  @@index([brandId])
  @@index([connectorType])
  @@map("vehicle_models")
}

model UserVehicle {
  id        String  @id @default(uuid())
  userId    String
  modelId   String
  nickname  String?
  isPrimary Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  model VehicleModel @relation(fields: [modelId], references: [id])

  @@unique([userId, modelId])
  @@index([userId])
  @@index([modelId])
  @@map("user_vehicles")
}

// ============================================================================
// STATIONS & INFRASTRUCTURE
// ============================================================================

model Network {
  id          String  @id @default(uuid())
  name        String  @unique
  website     String?
  logoUrl     String?
  phoneNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stations Station[]

  @@map("networks")
}

model Station {
  id           String      @id @default(uuid())
  networkId    String?
  name         String
  description  String?
  stationType  StationType @default(EV)
  operatorName String?
  serviceType  String?

  // Location
  address          String
  area             String? // Neighbourhood / district (e.g. "Victoria Island", "Lekki")
  city             String
  state            String
  postalCode       String?
  country          String  @default("NG") // Nigeria first
  latitude         Float
  longitude        Float
  timezone         String  @default("Africa/Lagos")
  locationAccuracy String?
  navigationReady  Boolean @default(false)

  // Status
  isActive   Boolean       @default(true)
  isVerified Boolean       @default(false) // Admin verified
  status     StationStatus @default(PENDING)

  // Submission tracking
  submittedBy        String? // FK → User.id (null for seeded/admin-created stations)
  submissionKey      String? // Client-generated idempotency key for community submissions
  rejectionReason    String? // Set when status = REJECTED
  reviewReason       String?
  reviewedBy         String?
  reviewedAt         DateTime?
  changesRequestedAt DateTime?
  withdrawnAt        DateTime?
  submissionRevision Int       @default(1)

  // Operating Hours (JSON: { "mon": { "open": "08:00", "close": "22:00" }, ... } or null for 24h)
  // Use "24h" as special value for always open
  operatingHours Json?

  // Amenities (JSON array: ["restrooms", "wifi", "food", "shopping", "parking"])
  amenities Json @default("[]")

  // Pricing (JSON: { "perKwh": 350, "perMinute": null, "sessionFee": 500, "currency": "NGN" })
  pricing          Json?
  priceNote        String?
  openingHoursNote String?

  // CNG-specific metadata (JSON: { "dispenserCount": 4, "pressureRating": "200 bar", "paymentMethods": ["cash", "card"], "availabilityStatus": "AVAILABLE" })
  cngDetails Json?

  // Research provenance and confidence
  accessNotes            String?
  operationalStatus      String?
  verificationTier       String?
  verificationConfidence Float?
  verificationBasis      String?
  verifiedAt             DateTime?
  sourceLinks            Json      @default("[]")
  researchMetadata       Json?

  // Contact
  phoneNumber String?
  email       String?

  // Aggregate Stats (denormalized for performance)
  totalPorts     Int    @default(0)
  availablePorts Int    @default(0)
  avgRating      Float?
  reviewCount    Int    @default(0)

  // Tracking
  lastStatusUpdate DateTime?
  currentCngAvailability CngAvailabilityStatus @default(UNKNOWN)
  currentQueueLength     Int?
  currentPressureBar     Decimal?              @db.Decimal(6, 2)
  cngStatusUpdatedAt     DateTime?
  cngStatusUpdatedBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  network    Network?       @relation(fields: [networkId], references: [id])
  submitter  User?          @relation("SubmittedStations", fields: [submittedBy], references: [id])
  reviewer   User?          @relation("ReviewedStations", fields: [reviewedBy], references: [id], onDelete: SetNull)
  ports      Port[]
  favorites  Favorite[]
  reviews    Review[]
  images     StationImage[]
  associations       StationAssociation[]
  conditionReports   StationConditionReport[]
  availabilityEvents StationAvailabilityEvent[]

  @@index([networkId])
  @@index([latitude, longitude])
  @@index([city, state])
  @@index([isActive])
  @@unique([submittedBy, submissionKey])
  @@index([status, isActive, createdAt])
  @@index([submittedBy, createdAt])
  @@index([stationType])
  @@index([avgRating])
  @@index([verificationTier])
  @@index([navigationReady])
  @@map("stations")
}

model StationAssociation {
  id         String                   @id @default(uuid())
  stationId  String
  userId     String
  role       StationAssociationRole   @default(EMPLOYEE)
  status     StationAssociationStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  station  Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  user     User    @relation("StationAssociationUser", fields: [userId], references: [id], onDelete: Cascade)
  approver User?   @relation("StationAssociationApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@unique([stationId, userId])
  @@index([userId, status])
  @@index([stationId, status])
  @@map("station_associations")
}

model StationConditionReport {
  id                   String                 @id @default(uuid())
  stationId            String
  availability         CngAvailabilityStatus
  estimatedQueueLength Int
  pumpPressureBar      Decimal                @db.Decimal(6, 2)
  reportedBy           String
  source               StationConditionSource @default(STATION_PORTAL)
  idempotencyKey       String
  reportedAt           DateTime               @default(now())

  station      Station               @relation(fields: [stationId], references: [id], onDelete: Restrict)
  reporter     User                  @relation("StationConditionReporter", fields: [reportedBy], references: [id], onDelete: Restrict)
  notifications CngNotificationEvent[]

  @@unique([reportedBy, idempotencyKey])
  @@index([stationId, reportedAt(sort: Desc)])
  @@map("station_condition_reports")
}

model StationAvailabilityEvent {
  id         String                 @id @default(uuid())
  stationId  String
  status     CngAvailabilityStatus
  startedAt  DateTime               @default(now())
  endedAt    DateTime?
  updatedBy  String
  source     StationConditionSource @default(STATION_PORTAL)
  createdAt  DateTime               @default(now())

  station  Station @relation(fields: [stationId], references: [id], onDelete: Restrict)
  reporter User    @relation("StationAvailabilityReporter", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([stationId, startedAt(sort: Desc)])
  @@index([stationId, endedAt])
  @@map("station_availability_events")
}

model CngNotificationEvent {
  id                String                @id @default(uuid())
  conditionReportId String?
  kind              CngNotificationKind
  recipientScope    String
  status            CngNotificationStatus @default(PENDING)
  deduplicationKey  String                @unique
  providerMessageId String?
  attemptCount      Int                   @default(0)
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  conditionReport StationConditionReport? @relation(fields: [conditionReportId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([conditionReportId])
  @@map("cng_notification_events")
}

model Port {
  id            String        @id @default(uuid())
  stationId     String
  connectorType ConnectorType
  chargerType   ChargerType
  powerKw       Float?
  status        PortStatus    @default(UNKNOWN)

  // Pricing (can override station pricing)
  pricePerKwh     Float?
  pricePerMinute  Float?
  pricePerSession Float?

  // Port identifier at the station (e.g., "A1", "B2")
  portNumber String?

  // Availability tracking
  estimatedAvailableAt DateTime? // When port might be available if IN_USE
  lastStatusUpdate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@index([status])
  @@index([connectorType])
  @@map("ports")
}

model StationImage {
  id         String  @id @default(uuid())
  stationId  String
  url        String
  caption    String?
  sortOrder  Int     @default(0)
  isPrimary  Boolean @default(false)
  uploadedBy String? // userId who uploaded

  createdAt DateTime @default(now())

  // Relations
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@index([sortOrder])
  @@map("station_images")
}

// ============================================================================
// USER INTERACTIONS
// ============================================================================

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  stationId String
  createdAt DateTime @default(now())

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
  @@index([userId])
  @@index([stationId])
  @@map("favorites")
}

model Review {
  id         String  @id @default(uuid())
  userId     String
  stationId  String
  rating     Int // 1-5 stars
  comment    String?
  anonHandle String? // e.g. "QuietCraneBrewer" — generated once on creation, never changes

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, createdAt])
  @@index([userId])
  @@map("reviews")
}

// ============================================================================
// CNG FINANCING APPLICATIONS
// ============================================================================

model CngApplication {
  id        String               @id @default(uuid())
  reference String               @unique
  userId    String
  status    CngApplicationStatus @default(DRAFT)

  // Personal details
  firstName       String?
  middleName      String?
  lastName        String?
  gender          String?
  dateOfBirth     DateTime?
  maritalStatus   String?
  email           String?
  phone           String?
  phoneVerifiedAt DateTime?
  bvnEncrypted    String?
  bvnHash         String?
  bvnLast4        String?
  ninEncrypted    String?
  ninHash         String?
  ninLast4        String?

  // Employment and address
  currentlyEmployed          Boolean?
  employmentStatus           String?
  employmentSector           String?
  employerName               String?
  occupationJobTitle         String?
  monthlyIncome              String?
  employmentStartDate        DateTime?
  employmentConfirmationDate DateTime?
  address                    String?
  state                      String?
  lga                        String?
  nextOfKinName              String?
  nextOfKinPhone             String?
  nextOfKinRelationship      String?
  personalCompletedAt        DateTime?

  // Vehicle details
  vehicleBrand       String?
  vehicleModel       String?
  vehicleYear        Int?
  manufacturingDate  DateTime?
  vehicleColor       String?
  mileage            String?
  fuelSystem         String?
  engineType         String?
  licensePlate       String?
  chassisNumber      String?
  engineNumber       String?
  vehicleCompletedAt DateTime?

  // Financing selection and immutable quote snapshot
  packageId            String?
  financingPlanId      String?
  preferredLoanTenor   Int?
  packagePriceNgn      Int?
  depositAmountNgn     Int?
  financedAmountNgn    Int?
  interestAmountNgn    Int?
  monthlyPaymentNgn    Int?
  totalCostNgn         Int?
  privacyConsentAt     DateTime?
  privacyPolicyVersion String?
  financingCompletedAt DateTime?

  // Workflow metadata
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNote      String?
  rejectionReason String?
  inspectionAppointmentAt DateTime?
  financingApprovedAt DateTime?
  conversionAppointmentAt DateTime?
  financeDisbursedAt DateTime?
  conversionCompletedAt DateTime?
  fullyPaidAt DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  applicant          User                     @relation("CngApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer           User?                    @relation("CngReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  documents          CngApplicationDocument[]
  phoneVerifications CngPhoneVerification[]
  reviewNotes        CngApplicationReviewNote[]
  installments       CngInstallment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([phone])
  @@index([bvnHash])
  @@index([ninHash])
  @@map("cng_applications")
}

model CngApplicationReviewNote {
  id            String   @id @default(uuid())
  applicationId String
  authorId      String
  note          String
  createdAt     DateTime @default(now())

  application CngApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("cng_application_review_notes")
}

model CngInstallment {
  id                String               @id @default(uuid())
  applicationId     String
  number            Int
  amountNgn         Int
  dueAt             DateTime
  status            CngInstallmentStatus @default(PENDING)
  paidAt            DateTime?
  providerReference String?
  webhookEventId    String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  application CngApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, number])
  @@index([applicationId, status])
  @@map("cng_installments")
}

model CngApplicationDocument {
  id             String             @id @default(uuid())
  applicationId  String
  type           String
  originalName   String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  uploadedAt     DateTime           @default(now())
  scanStatus     DocumentScanStatus @default(PENDING)
  scannedAt      DateTime?
  scannerVersion String?

  application CngApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, type])
  @@index([applicationId])
  @@map("cng_application_documents")
}

model CngPhoneVerification {
  id            String    @id @default(uuid())
  applicationId String
  phone         String
  codeHash      String
  attempts      Int       @default(0)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  application CngApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, phone, createdAt])
  @@index([expiresAt])
  @@map("cng_phone_verifications")
}

// Append-only record of privileged access and mutations. Application code exposes
// create/read operations only; production DB permissions should deny UPDATE/DELETE.
model AuditEvent {
  id            String           @id @default(uuid())
  actorId       String?
  actorRole     UserRole?
  action        String
  targetType    String
  targetId      String?
  reason        String?
  requestId     String
  ipAddress     String?
  userAgent     String?
  sensitivity   AuditSensitivity @default(STANDARD)
  beforeSummary Json?
  afterSummary  Json?
  metadata      Json?
  occurredAt    DateTime         @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_events")
}
