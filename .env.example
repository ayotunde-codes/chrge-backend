# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (local dev)
# For local dev, both vars point to the same Docker Postgres instance.
DATABASE_URL="postgresql://chrge:chrge_secret@localhost:5434/chrge_dev?schema=public"
DIRECT_URL="postgresql://chrge:chrge_secret@localhost:5434/chrge_dev?schema=public"

# Neon (production) — replace both vars with values from Neon dashboard → Connection Details
# DATABASE_URL  → "Pooled connection" string  (used by the app at runtime)
# DIRECT_URL    → "Direct connection" string  (used by Prisma for migrations only)
# DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.neon.tech/<dbname>?sslmode=require"
# DIRECT_URL="postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require"

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Refresh Token Pepper (used to hash refresh tokens)
REFRESH_TOKEN_PEPPER=your-super-secret-refresh-token-pepper-change-in-production

# Staff identity and MFA. Base64 value must decode to exactly 32 random bytes.
ADMIN_MFA_ENCRYPTION_KEY=
# Used only by the one-time bootstrap CLI; remove immediately after execution.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_MFA_SECRET_ENCRYPTED=
ADMIN_RECOVERY_CODES=
RECOVERY_CODE_PEPPER=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=your-ios-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-google-client-id.apps.googleusercontent.com

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10

# CNG financing applications
# Use a dedicated random secret of at least 32 characters. It is mandatory in production.
CNG_APPLICATION_ENCRYPTION_KEY=replace-with-a-long-random-production-secret
CNG_DOCUMENT_STORAGE_PATH=private-uploads/cng-applications
CNG_APPLICATIONS_ENABLED=false
CHRGE_ENV=development

# Staging-only QA clearance after strict MIME, size, and file-signature checks.
# Keep unset in production until a malware scanning service is connected.
CNG_DOCUMENT_SCAN_MODE=

# Private Cloudflare R2 document storage (mandatory in production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chrge-private-documents

# Keep false in production unless API documentation is temporarily required.
ENABLE_SWAGGER=false

# Optional provider webhook. The API sends { phone, code, purpose } as JSON.
# Keep delivery disabled until a trusted provider URL and credential are set.
# Development codes are returned only when this is explicitly true outside production.
CNG_OTP_DELIVERY_ENABLED=false
CNG_OTP_WEBHOOK_URL=
CNG_OTP_WEBHOOK_TOKEN=
# Staging-only comma-separated E.164 QA numbers. The code is returned in the UI
# only for these recipients when no real SMS provider is configured.
CNG_OTP_TEST_RECIPIENTS=
# Staging-only comma-separated E.164 allowlist. The test code is returned only
# for these QA numbers when no SMS provider is configured.
CNG_OTP_TEST_RECIPIENTS=

# Direct Termii SMS delivery (alternative to the generic webhook above).
# Use the account-specific HTTPS base URL shown in the Termii dashboard.
TERMII_BASE_URL=
TERMII_API_KEY=
TERMII_SENDER_ID=CHRGE
TERMII_CHANNEL=dnd
